1. INSERT EXPLICIT NULL THROUGH A NULLABLE VIEW
CREATE TABLE VIEW_NULLABLE_BASE(ID INT NULL);
SUCCESS
CREATE VIEW VIEW_NULLABLE AS SELECT ID FROM VIEW_NULLABLE_BASE;
SUCCESS
INSERT INTO VIEW_NULLABLE(ID) VALUES(NULL);
SUCCESS
SELECT COUNT(*) FROM VIEW_NULLABLE_BASE;
1
COUNT(*)

2. LET BASE TABLE CONSTRAINTS REJECT NULL
CREATE TABLE VIEW_NOT_NULL_BASE(ID INT NOT NULL);
SUCCESS
CREATE VIEW VIEW_NOT_NULL AS SELECT ID FROM VIEW_NOT_NULL_BASE;
SUCCESS
INSERT INTO VIEW_NOT_NULL(ID) VALUES(NULL);
FAILURE
SELECT COUNT(*) FROM VIEW_NOT_NULL_BASE;
0
COUNT(*)
3. ROUTE A PARTIAL INSERT INTO ONLY ONE BASE TABLE OF A JOIN VIEW
CREATE TABLE CREATE_VIEW_T1(ID INT, AGE INT, NAME CHAR(10));
SUCCESS
CREATE TABLE CREATE_VIEW_T2(ID INT, AGE INT, NAME CHAR(10));
SUCCESS
CREATE VIEW CREATE_VIEW_V4 AS SELECT T1.ID AS ID, T1.AGE AS AGE, T2.NAME AS NAME FROM CREATE_VIEW_T1 T1, CREATE_VIEW_T2 T2 WHERE T1.ID=T2.ID;
SUCCESS
INSERT INTO CREATE_VIEW_V4 VALUES(8, 8, 'IPL2NX');
FAILURE
INSERT INTO CREATE_VIEW_V4(ID, AGE) VALUES(59, 59);
SUCCESS
SELECT COUNT(*) FROM CREATE_VIEW_T1;
1
COUNT(*)
SELECT COUNT(*) FROM CREATE_VIEW_T2;
0
COUNT(*)
